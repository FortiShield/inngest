{
  "name": "@inngest/dashboard-next",
  "description": "Inngest Dashboard - Next.js 16 with App Router",
  "license": "UNLICENSED",
  "homepage": "https://app.inngest.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/inngest/inngest.git",
    "directory": "apps/ui/apps/dashboard-next"
  },
  "author": "Inngest Inc. <info@inngest.com> (https://inngest.com/)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --prefix-colors \"green.inverse,magenta.inverse\" \"pnpm dev:next\" \"pnpm dev:graphql-codegen\"",
    "dev:next": "next dev",
    "dev:graphql-codegen": "graphql-codegen -w -r dotenv/config",
    "build": "pnpm build:tsc && pnpm build:graphql-codegen && pnpm build:next",
    "build:tsc": "tsc --noEmit",
    "build:graphql-codegen": "if test \"$VERCEL_ENV\" = \"production\"; then pnpm graphql-codegen; fi",
    "build:next": "next build",
    "start": "next start",
    "graphql-codegen": "graphql-codegen -r dotenv/config",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "env:pull": "npx vercel env pull",
    "env:add": "npx vercel env add",
    "env:rm": "npx vercel env rm"
  },
  "dependencies": {
    "@clerk/nextjs": "^5.5.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@inngest/components": "workspace:*",
    "@remixicon/react": "^4.7.0",
    "@segment/analytics-next": "^1.81.1",
    "@sentry/nextjs": "^8.0.0",
    "@stripe/react-stripe-js": "^3.1.1",
    "@stripe/stripe-js": "^1.52.1",
    "@tanstack/react-query": "^5.66.5",
    "@tanstack/react-table": "^8.21.3",
    "@unpic/react": "^1.0.1",
    "@urql/exchange-auth": "^2.1.6",
    "@urql/exchange-request-policy": "^1.0.2",
    "@urql/exchange-retry": "^1.2.0",
    "change-case": "^5.4.4",
    "cmdk": "^1.0.4",
    "dotenv": "^17.2.3",
    "framer-motion": "^10.16.4",
    "graphql": "16.8.1",
    "graphql-config": "^4.5.0",
    "graphql-request": "^6.1.0",
    "inngest": "^3.48.0",
    "ky": "^0.33.3",
    "launchdarkly-react-client-sdk": "^3.0.8",
    "next": "^16.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.5.0",
    "react-use": "^17.6.0",
    "recharts": "^2.4.3",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.2.0",
    "sql-formatter": "^15.6.10",
    "swr": "^2.2.4",
    "type-fest": "^3.7.2",
    "ulid": "^2.3.0",
    "urql": "^4.0.5",
    "uuid": "^13.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/js": "^9.31.0",
    "@graphql-codegen/cli": "^6.0.2",
    "@graphql-codegen/client-preset": "^5.1.3",
    "@graphql-codegen/typescript": "^4.1.2",
    "@graphql-codegen/typescript-operations": "^4.2.2",
    "@inngest/eslint-config": "workspace:*",
    "@inngest/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/react-syntax-highlighter": "^15.5.6",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^7.6.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^16.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.5.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^1.1.0"
  },
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": "20.x",
    "pnpm": "10.x"
  }
}
